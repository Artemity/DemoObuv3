<Window x:Class="DemoObuv3.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DemoObuv3"
        mc:Ignorable="d"
        Title="Авторизация" Height="300" Width="300" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Icon="/Icon.png">
    <Grid>
        <StackPanel Margin="10">
            <Label Content="Логин:"/>
            <TextBox x:Name="tbLogin" Height="25" Margin="0,0,0,15"/>

            <Label Content="Пароль:"/>
            <PasswordBox x:Name="tbPass" Height="25" Margin="0,0,0,35"/>

            <Button Content="Войти" Margin="0,0,0,10" Click="btnLogin_Click"/>
            <Button Content="Войти как гость" Click="btnLoginAsGuest_Click"/>
        </StackPanel>
    </Grid>
</Window>

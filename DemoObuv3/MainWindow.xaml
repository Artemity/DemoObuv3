<Window x:Class="DemoObuv3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DemoObuv3"
        mc:Ignorable="d"
        Title="Обувь" x:Name="mainWindow" Height="650" Width="1050" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Icon="/Icon.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="21*"/>
            <RowDefinition Height="69*"/>
            <RowDefinition Height="544*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="Выйти" Click="btnExit_Click"/>
            <MenuItem Header="Добавить" x:Name="mAdd" Click="mAdd_Click"/>
            <MenuItem Header="Редактировать" x:Name="mEdit" Click="mEdit_Click"/>
            <MenuItem Header="Удалить" x:Name="mDel" Click="mDel_Click"/>
            <Separator/>
        </Menu>

        <StackPanel Margin="10" Orientation="Horizontal" Grid.Row="1">
            <TextBox TextChanged="tbSearch_TextChanged" x:Name="tbSearch" Width="250" Height="30" Margin="0,0,15,0"/>
            <TextBlock Text="Гость" x:Name="tbUser" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <ListView x:Name="lvProducts" Grid.Row="2">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="3" Margin="5" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="Black" BorderThickness="2" Margin="5">
                                <Image Source="{Binding ImagePath}" Stretch="Uniform"/>
                            </Border>

                            <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="5">
                                <StackPanel Margin="10">
                                    <TextBlock FontWeight="Bold">
                                        <Run Text="{Binding Category}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding ProductName}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description, StringFormat= Описание: {0}}"/>
                                    <TextBlock Text="{Binding Manufacturer, StringFormat= Производитель: {0}}"/>
                                    <TextBlock Text="{Binding Supplier, StringFormat= Поставщик: {0}}"/>
                                    <TextBlock Text="{Binding Cost, StringFormat= Цена: {0}}"/>
                                    <TextBlock Text="{Binding Unit, StringFormat= Единица измерения: {0}}"/>
                                    <TextBlock Text="{Binding Quantity, StringFormat= Количество на складе: {0}}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" BorderBrush="Black" BorderThickness="2" Margin="5">
                                <TextBlock Text="{Binding SaleNow, StringFormat= Действующая скидка: {0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>

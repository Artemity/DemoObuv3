<Window x:Class="DemoObuv3.AddEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DemoObuv3"
        mc:Ignorable="d"
        Title="Добавленение/Редактирование" Height="500" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" Icon="/Icon.png">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Артикул:"/>
            <TextBox x:Name="tbArticle"/>

            <TextBlock Text="Название продукции:"/>
            <TextBox x:Name="tbProductName"/>

            <TextBlock Text="Единица измерения:"/>
            <TextBox x:Name="tbUnit"/>

            <TextBlock Text="Цена:"/>
            <TextBox x:Name="tbCost"/>

            <TextBlock Text="Поставщик:"/>
            <TextBox x:Name="tbSupplier"/>

            <TextBlock Text="Производитель:"/>
            <TextBox x:Name="tbManufacturer"/>

            <TextBlock Text="Категория товара:"/>
            <TextBox x:Name="tbCategory"/>

            <TextBlock Text="Скидка:"/>
            <TextBox x:Name="tbSaleNow"/>

            <TextBlock Text="Количество на складе:"/>
            <TextBox x:Name="tbQuantity"/>

            <TextBlock Text="Описание:"/>
            <TextBox x:Name="tbDescription"/>

            <TextBlock Text="Фото"/>
            <TextBox x:Name="tbPhoto"/>

            <Button Content="Сохранить" Margin="0,20,0,0" Click="btnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
